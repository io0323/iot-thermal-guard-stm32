{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "ホスト版＋全テスト（ASan・UBSan）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TG_SANITIZE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "host-coverage",
      "displayName": "ホスト版＋全テスト（gcov、サニタイザーなし）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-cov",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TG_COVERAGE": "ON",
        "TG_SANITIZE": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "target-debug",
      "displayName": "ターゲット版（STM32F401RE、-Og -g3）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TG_TARGET": "ON",
        "TG_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "target-release",
      "displayName": "ターゲット版（STM32F401RE、-Os -g）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target-release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TG_TARGET": "ON",
        "TG_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "target-renode",
      "displayName": "Renode 用（target-release＋ADC_SOFTWARE_START=1＋テスト用の変数。実機とは ADC の開始方法が違う）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target-renode",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TG_TARGET": "ON",
        "TG_SANITIZE": "OFF",
        "BUILD_TESTING": "OFF",
        "TG_ADC_SOFTWARE_START": "ON",
        "TG_RENODE_TEST_HOOKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage"
    },
    {
      "name": "target-debug",
      "configurePreset": "target-debug"
    },
    {
      "name": "target-release",
      "configurePreset": "target-release"
    },
    {
      "name": "target-renode",
      "configurePreset": "target-renode"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
